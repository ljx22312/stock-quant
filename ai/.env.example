# AI 助手子系统配置模板。复制到仓库根目录为 .env 并填入真实值（.env 已被 gitignore，绝不上传）
# worker.js / server.js 启动时自动读取仓库根 .env

# AI 模型密钥（pi coding agent providers，见 ai/extensions/providers.js）
KIMI_API_KEY=
OPENCODE_API_KEY=

# 可选：本地 HTTP 服务器 Bearer 令牌（server.js，不用 server.js 可留空）
AI_TOKEN=

# 可选：专家 skill 目录（默认使用仓库内 ai/skill）
# SKILL_BASE=/path/to/your/skills

# ---- 遗留兼容（仅当 LOCAL_DB_BASE 指向旧云端网关时才需要，纯本地部署留空）----
# TCB_ENV=
# CB_API_KEY=

# 备用 AI 模型密钥：主 key (KIMI_API_KEY) 额度耗尽时自动切换，恢复后自动切回
# 由 ai/kimi-failover-proxy.js 实现（systemd: stock-ai-keyproxy.service）
KIMI_API_KEY_BACKUP=

# 可选：覆盖 Kimi 上游地址（默认经本机故障转移代理 http://127.0.0.1:8799/v1）
# KIMI_BASE_URL=
# KEYPROXY_PORT=8799
# KEYPROXY_COOLDOWN_MS=300000

# 二级备用 key：主 key 与备用 key 都失败时才使用；三个都失败则返回友好提示
KIMI_API_KEY_BACKUP2=

# 可选：全部 key 不可用时返回给用户的提示语
# KEYPROXY_EXHAUSTED_MESSAGE=目前 AI 模型额度已用尽，请稍后再询问。
